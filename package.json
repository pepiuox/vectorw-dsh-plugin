{
  "name": "@deepseek-ai/dsh-plugin-vectorw",
  "version": "1.4.0",
  "private": true,
  "description": "VectorW (vOS v6.0) como caché semántica de firma W 4D, predictor de consultas y memoria de procesos/lecciones en SQLite para DeepSeek Harness: evita repetir trabajo y reduce tokens",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib/index.js",
    "bridge_vos.py",
    "memoria_vectorw.py",
    "cordis.patch.yml",
    "vendor/**/*.py",
    "vendor/NOTICE.md"
  ],
  "license": "SEE LICENSE IN LICENSE.md",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.2"
  }
}
